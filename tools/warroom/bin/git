#!/usr/bin/env python3
"""Worker-facing Git shim: keep War Room-owned worktree/branch cleanup in Supervisor."""
from __future__ import annotations

import os
import sys


def _command(argv: list[str]) -> tuple[str | None, list[str]]:
    """Skip Git global options and return the command plus its remaining arguments."""
    value_options = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path", "--super-prefix",
                     "--config-env"}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            return None, []
        if arg in value_options:
            i += 2
        elif arg.startswith("--") and "=" in arg:
            i += 1
        elif arg.startswith("-"):
            i += 1
        else:
            return arg, argv[i + 1:]
    return None, []


def main() -> int:
    argv = sys.argv[1:]
    command, rest = _command(argv)
    blocked = False
    if command == "worktree":
        # `list` is read-only; every other worktree lifecycle operation is Supervisor-owned.
        blocked = bool(rest and rest[0] != "list")
    elif command == "branch":
        blocked = any(arg in ("-d", "-D", "--delete", "-m", "-M", "--move", "-c", "-C", "--copy",
                              "-f", "--force", "--set-upstream-to", "--unset-upstream") for arg in rest)
    elif command == "update-ref":
        # Producer jobs need normal commits/pushes, never direct ref manipulation.
        blocked = True
    if blocked:
        print("War Room Supervisor owns worktree and branch cleanup; leave the assigned checkout intact.",
              file=sys.stderr)
        return 126

    real_git = os.environ.get("WARROOM_REAL_GIT", "")
    if not os.path.isabs(real_git) or not os.path.isfile(real_git):
        print("War Room's real Git executable is not configured.", file=sys.stderr)
        return 127
    os.execv(real_git, [real_git, *argv])
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
