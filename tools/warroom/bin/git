#!/usr/bin/env python3
"""Worker-facing Git shim: keep War Room-owned worktree/branch cleanup in Supervisor."""
from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from warroom.realgit import resolve_git  # noqa: E402


_EXEC_MARK = "WARROOM_GIT_SHIM_EXEC_PID"


def _command(argv: list[str]) -> tuple[str | None, list[str]]:
    """Skip Git global options and return the command plus its remaining arguments."""
    value_options = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path", "--super-prefix",
                     "--config-env"}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            return None, []
        if arg in value_options:
            i += 2
        elif arg.startswith("--") and "=" in arg:
            i += 1
        elif arg.startswith("-"):
            i += 1
        else:
            return arg, argv[i + 1:]
    return None, []


def _real_git() -> tuple[str | None, str]:
    """Find Git behind this shim, plus the PATH to run it with: that PATH never contains the shim.

    macOS's /usr/bin/git is an xcrun stub that looks `git` up through xcrun's cache and, failing that, on PATH. With
    the shim on PATH (or its path left in xcrun's cache by an earlier run), the stub runs the shim again and the exec
    chain loops. The shared resolver therefore swaps the stub for the developer-dir Git it would run, executed
    directly, and never returns the shim."""
    shim = Path(__file__).resolve()
    search_path = []
    for entry in os.environ.get("PATH", os.defpath).split(os.pathsep):
        try:
            if (Path(entry or os.curdir) / "git").resolve() == shim:
                continue
        except OSError:
            continue
        search_path.append(entry)
    clean_path = os.pathsep.join(search_path)
    return resolve_git({**os.environ, "PATH": clean_path}), clean_path


def main() -> int:
    argv = sys.argv[1:]
    command, rest = _command(argv)
    blocked = False
    chunk_run = os.environ.get("WARROOM_STAGE2_CHUNK") == "1"
    if chunk_run:
        # Chunk runs do not need Git (not even `git --version`); never delegate to an executable behind this shim.
        blocked = True
    elif command == "worktree":
        # `list` is read-only; every other worktree lifecycle operation is Supervisor-owned.
        blocked = bool(rest and rest[0] != "list")
    elif command == "branch":
        blocked = any(arg in ("-d", "-D", "--delete", "-m", "-M", "--move", "-c", "-C", "--copy",
                              "-f", "--force", "--set-upstream-to", "--unset-upstream") for arg in rest)
    elif command == "update-ref":
        # Producer jobs need normal commits/pushes, never direct ref manipulation.
        blocked = True
    if blocked:
        message = ("Stage 2 chunk runs cannot access Git; leave the assigned HEAD and branch unchanged."
                   if chunk_run else
                   "War Room Supervisor owns worktree and branch cleanup; leave the assigned checkout intact.")
        print(message, file=sys.stderr)
        return 126

    if os.environ.get(_EXEC_MARK) == str(os.getpid()):
        # exec keeps the pid: this process already handed over to real Git and was re-entered (an xcrun loop).
        print("War Room Git shim was re-entered through the Git it runs; stopping the exec loop.", file=sys.stderr)
        return 126
    real_git, clean_path = _real_git()
    if not real_git:
        print("War Room's real Git executable is not configured.", file=sys.stderr)
        return 127
    env = {**os.environ, "PATH": clean_path, _EXEC_MARK: str(os.getpid())}
    os.execve(real_git, [real_git, *argv], env)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
