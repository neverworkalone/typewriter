#!/usr/bin/env python3
"""Worker-facing Git shim: keep War Room-owned worktree/branch cleanup in Supervisor."""
from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path


def _command(argv: list[str]) -> tuple[str | None, list[str]]:
    """Skip Git global options and return the command plus its remaining arguments."""
    value_options = {"-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path", "--super-prefix",
                     "--config-env"}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            return None, []
        if arg in value_options:
            i += 2
        elif arg.startswith("--") and "=" in arg:
            i += 1
        elif arg.startswith("-"):
            i += 1
        else:
            return arg, argv[i + 1:]
    return None, []


def _real_git() -> str | None:
    """Find Git behind this shim without publishing its executable path to worker processes."""
    shim = Path(__file__).resolve()
    search_path = []
    for entry in os.environ.get("PATH", os.defpath).split(os.pathsep):
        candidate = Path(entry or os.curdir) / "git"
        try:
            if candidate.resolve() == shim:
                continue
        except OSError:
            continue
        search_path.append(entry)
    real_git = shutil.which("git", path=os.pathsep.join(search_path))
    if real_git and Path(real_git).resolve() != shim:
        return real_git
    return None


def main() -> int:
    argv = sys.argv[1:]
    command, rest = _command(argv)
    blocked = False
    if os.environ.get("WARROOM_STAGE2_CHUNK") == "1" and command in {
        "add", "am", "apply", "checkout", "cherry-pick", "clean", "commit", "fetch", "merge", "pull",
        "push", "rebase", "reset", "restore", "revert", "stash", "switch", "tag",
    }:
        blocked = True
    if command == "worktree":
        # `list` is read-only; every other worktree lifecycle operation is Supervisor-owned.
        blocked = bool(rest and rest[0] != "list")
    elif command == "branch":
        blocked = any(arg in ("-d", "-D", "--delete", "-m", "-M", "--move", "-c", "-C", "--copy",
                              "-f", "--force", "--set-upstream-to", "--unset-upstream") for arg in rest)
    elif command == "update-ref":
        # Producer jobs need normal commits/pushes, never direct ref manipulation.
        blocked = True
    if blocked:
        message = ("Stage 2 chunk runs cannot modify Git state; leave the assigned HEAD and branch unchanged."
                   if os.environ.get("WARROOM_STAGE2_CHUNK") == "1" else
                   "War Room Supervisor owns worktree and branch cleanup; leave the assigned checkout intact.")
        print(message, file=sys.stderr)
        return 126

    real_git = _real_git()
    if not real_git:
        print("War Room's real Git executable is not configured.", file=sys.stderr)
        return 127
    os.execv(real_git, [real_git, *argv])
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
