    "batch:m5-10:wave-b:preimport": "node scripts/batch/build-m5-10-wave-b-preimport-inventory.mjs",
    "batch:m5-10:wave-b:build": "node scripts/batch/build-m5-10-wave-b.mjs",
    "batch:m5-10:wave-b:check": "node scripts/batch/validate-m5-10-wave-b.mjs",
    "batch:m5-10:wave-b:timing": "node scripts/batch/record-m5-10-wave-b-timing.mjs",
    "batch:m5-10:wave-b:editorial": "node scripts/batch/record-m5-10-wave-b-editorial.mjs",
