    "batch:m5-10a:calibration:build": "node scripts/batch/build-m5-10a-calibration.mjs",
    "batch:m5-10a:repair:check": "node scripts/batch/validate-m5-10a-repair.mjs",
    "batch:m5-10a:wave-a2:build": "node scripts/batch/build-m5-10a-wave-a2.mjs",
    "batch:m5-10a:wave-a2:check": "node scripts/batch/validate-m5-10a-wave-a2.mjs",
    "batch:m5-10a:wave-a2:timing": "node scripts/batch/record-m5-10a-wave-a2-timing.mjs",
    "batch:m5-10a:wave-a2:editorial": "node scripts/batch/record-m5-10a-wave-a2-editorial.mjs",
    "batch:m5-10a:wave-a2:audit": "node scripts/batch/record-m5-10a-wave-a2-audit.mjs",
