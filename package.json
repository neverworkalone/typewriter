  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
