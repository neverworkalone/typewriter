    "inventory:generate": "node scripts/inventory/generate-target-inventory.mjs",
    "validate:inventory": "node scripts/validate/target-inventory.mjs",
    "validate:rules": "node scripts/validate/rule-inventory.mjs",
    "batch:validate": "node scripts/batch/validate-batch.mjs",
