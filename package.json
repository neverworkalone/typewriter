{
  "name": "typewriter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ui": "vite build --mode ui",
    "dev:web": "vite --config vite.web.config.js",
    "build:web": "vite build --config vite.web.config.js",
    "test:web:integration": "node scripts/test-web-landing-integration.mjs",
    "test:extension:runtime": "node scripts/test-web-runtime-integration.mjs",
    "validate:product-outputs": "node scripts/validate/product-output-contract-cli.mjs",
    "validate": "node scripts/validate/canonical-jsonl.mjs && node scripts/validate/dataset-integrity.mjs && node scripts/validate/rule-inventory.mjs && pnpm run validate:lexical && pnpm run validate:surface-forms",
    "validate:lexical": "node scripts/validate/lexical-quality.mjs && node scripts/validate/semantic-audit.mjs",
    "validate:semantic-audit": "node scripts/validate/semantic-audit.mjs",
    "validate:artifacts": "node scripts/validate/artifact-policy.mjs",
    "validate:pages-artifact": "node scripts/validate/pages-artifact.mjs",
    "audit:semantic:build": "node scripts/validate/build-semantic-audit.mjs",
    "validate:rules": "node scripts/validate/rule-inventory.mjs",
    "validate:surface-forms": "node scripts/validate/surface-form-projection.mjs",
    "batch:timing": "node scripts/batch/stage-timing.mjs",
    "validate:corpus-candidate-review": "node scripts/reference/validate-corpus-candidate-review.mjs",
    "normalize": "node scripts/normalize/canonical.mjs",
    "build:dictionary": "node scripts/build/dictionary.mjs",
    "package": "bash pack.sh",
    "package:minify": "bash pack.sh --minify",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "reference:corpus:build": "node scripts/reference/build-corpus-index.mjs",
    "reference:corpus:candidates": "node scripts/reference/run-corpus-lemma-pilot.mjs",
    "reference:corpus:morphology": "node scripts/python/run.mjs scripts/reference/corpus_morphology.py",
    "factory:stage1": "node scripts/factory/produce-candidates.mjs",
    "factory:stage2": "node scripts/factory/run-stage2-worker.mjs",
    "factory:stage3": "node scripts/factory/run-stage3-worker.mjs",
    "reference:corpus:search": "node scripts/reference/search-corpus-index.mjs",
    "reference:literature:select": "node scripts/reference/build-literature-index.mjs select",
    "reference:literature:build": "node scripts/reference/build-literature-index.mjs build",
    "reference:literature:verify": "node scripts/reference/build-literature-index.mjs verify",
    "reference:literature:full-build": "node scripts/reference/build-literature-index.mjs full-build",
    "reference:literature:full-verify": "node scripts/reference/build-literature-index.mjs full-verify",
    "reference:literature:search": "node scripts/reference/search-literature-index.mjs",
    "factory:literature-rescue": "node scripts/factory/literature-rescue-cli.mjs",
    "relation:candidates": "node scripts/relation/stage2-candidates.mjs",
    "relation:correct": "node scripts/relation/correct-cli.mjs",
    "reference:literature:evidence": "node scripts/reference/literature-evidence-pack.mjs",
    "reference:literature:validate": "node scripts/reference/literature-validation.mjs",
    "reference:literature:boundary:measure": "node scripts/reference/literature-boundary-measure.mjs",
    "reference:literature:boundary:judge": "node scripts/reference/literature-boundary-judge.mjs",
    "test:mv3:product": "node scripts/extension/run-cft-product.mjs",
    "test:mv3:package": "node scripts/extension/run-cft-package.mjs",
    "verify:m2": "node scripts/verify/m2-pipeline.mjs",
    "ci:category": "node scripts/ci/run-category.mjs",
    "ci:fast": "node scripts/ci/run-category.mjs fast",
    "ci:candidates": "node scripts/ci/run-category.mjs candidates",
    "ci:normal": "node scripts/ci/run-category.mjs normal",
    "ci:all": "node scripts/ci/run-category.mjs all",
    "ci:pr": "node scripts/ci/run-category.mjs pr",
    "ci:deep": "node scripts/ci/run-category.mjs deep",
    "test": "pnpm run ci:normal",
    "python:bootstrap": "node scripts/python/bootstrap.mjs",
    "python:check": "node scripts/python/run.mjs --print",
    "intake:kiwi:test": "python3 scripts/intake/test_kiwi_service.py",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "playwright": "1.63.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
