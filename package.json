    "batch:m5-11:check": "node scripts/batch/check-m5-11.mjs",
    "batch:m5-11:admission:check": "node scripts/batch/validate-m5-11-admission.mjs",
    "batch:m5-11:admission:build": "node scripts/batch/build-m5-11-admission.mjs",
    "batch:m5-11:timing": "node scripts/batch/record-m5-11-timing.mjs",
    "batch:m5-11:promote": "node scripts/batch/promote-m5-11.mjs",
    "batch:m5-11:evidence:refresh": "node scripts/batch/refresh-m5-11-derived-evidence.mjs",
    "batch:timing:feedback": "node scripts/batch/timing.mjs --action=feedback",
    "batch:timing:start": "node scripts/batch/timing.mjs --action=start",
    "batch:timing:stop": "node scripts/batch/timing.mjs --action=stop",
    "normalize": "node scripts/normalize/canonical.mjs",
    "build:dictionary": "node scripts/build/dictionary.mjs",
    "validate:search": "node scripts/validate/search-regressions.mjs",
    "package": "bash pack.sh",
    "package:minify": "bash pack.sh --minify",
    "validate:package": "node scripts/validate-package.mjs",
    "test:mv3:product": "node scripts/extension/run-cft-product.mjs",
    "test:mv3:package": "node scripts/extension/run-cft-package.mjs",
    "verify:m2": "node scripts/verify/m2-pipeline.mjs",
    "test": "node --test tests/*.test.mjs && npm run batch:m5-10c:recovery:contract:check && npm run batch:m5-10d:recovery:contract:check",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
