#!/bin/sh
# War Room safe Supervisor restart (#5162): replace the Supervisor instance with the code this checkout holds now, then
# open the TUI. Nothing is killed by hand here: the TUI session, AI runs, batches, checkpoints and PRs are preserved and
# the new instance continues every batch from its own state. See tools/warroom/README.md.
exec "$(cd "$(dirname "$0")" && pwd)/war" --replace
