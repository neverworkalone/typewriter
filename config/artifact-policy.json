          "$.gate_evidence": ["schema_version", "contract_version", "artifact_id", "issue", "batch_id", "inputs", "preflight", "complete_audit"],
          "$.gate_evidence.inputs": ["prospective_canonical_sha256", "semantic_audit_sha256", "decision_source_sha256", "promotion_ledger_sha256"],
          "$.gate_evidence.preflight": ["contract_version", "status", "input_canonical_directory_sha256", "checks"],
          "$.gate_evidence.preflight.checks.*": ["status", "input_canonical_directory_sha256"],
          "$.gate_evidence.complete_audit": ["contract_version", "scope", "canonical_records_sha256", "record_count", "sense_count", "covered_record_count", "covered_sense_count", "coverage_complete", "review_complete", "corrected_record_count"],
          "$.sources": ["candidate_identities", "verification", "semantic_audit", "target_promotions", "base_inventory", "authorization"],
          "$.sources.candidate_identities": ["source_id", "path", "identity_sha256", "identity_count"],
          "$.sources.verification": ["source_id", "path", "sha256"],
          "$.sources.semantic_audit": ["source_id", "path", "sha256"],
          "$.sources.target_promotions": ["source_id", "path", "sha256"],
          "$.sources.base_inventory": ["source_id", "path", "sha256"],
          "$.sources.authorization": ["source_id", "path", "sha256"],
          "$.promotion": ["canonical_mutation", "seed_mutation", "inventory_mutation", "semantic_decision_source_mutation", "note"],
          "$.provenance": ["generation_pass_id", "verification_pass_id", "raw_material_excluded", "batch_local_quality_fork", "base_decision_source_id"]
        }
      },
      "promotion_manifest": {
        "contract_versions": [
          "lexical-batch-promotion-v2"
        ],
        "allowed_fields": [
          "schema_version",
          "contract_version",
          "artifact_id",
          "issue",
          "parent_issue",
          "grandparent_issue",
          "batch_id",
          "status",
          "admission_sha256",
          "preflight",
          "gate_evidence_sha256",
          "outputs",
          "closed_issues",
          "checkpoint",
          "promotion",
          "post_promotion_audit"
        ],
        "nested_allowed_fields": {
          "$.preflight": ["contract_version", "status", "input_canonical_directory_sha256", "checks"],
          "$.preflight.checks.*": ["status", "input_canonical_directory_sha256"],
          "$.outputs": ["canonical_directory_sha256", "canonical_import", "seed", "target_promotions", "inventory", "semantic_decision_source"],
          "$.outputs.canonical_import": ["path", "sha256", "record_count", "first_canonical_id", "last_canonical_id"],
          "$.outputs.seed": ["path", "sha256", "target_count"],
          "$.outputs.target_promotions": ["path", "sha256", "event_count"],
          "$.outputs.inventory": ["path", "materialization", "sha256", "entry_count"],
          "$.outputs.semantic_decision_source": ["path", "sha256", "source_id", "canonical_records_sha256"],
          "$.checkpoint": ["issue", "milestone", "canonical_records", "canonical_starts", "status"],
          "$.promotion": ["canonical_mutation", "seed_mutation", "inventory_mutation", "semantic_decision_source_mutation", "transaction"],
          "$.post_promotion_audit": ["status", "policy", "transaction", "canonical_directory_sha256", "seed_sha256", "promotion_ledger_sha256", "semantic_decision_source_sha256", "semantic_audit_sha256", "semantic_audit"],
          "$.post_promotion_audit.semantic_audit": ["contract_version", "scope", "canonical_records_sha256", "record_count", "sense_count", "covered_record_count", "covered_sense_count", "coverage_complete", "review_complete", "corrected_record_count"]
        }
      },
      "decision_source": {
        "contract_versions": [
          "lexical-semantic-decision-source-v2"
        ],
        "allowed_fields": [
          "schema_version",
          "contract_version",
          "kind",
          "source_id",
          "authoring_mode",
          "issue",
          "parent_issue",
          "batch_id",
          "provenance",
          "candidate_source",
          "selection",
          "decisions",
          "review",
          "candidate_records",
          "candidate_records_sha256",
          "artifact_sha256"
        ],
        "decision_allowed_fields": [
          "candidate_record_id",
          "inventory_id",
          "candidate_record_sha256",
          "decision",
          "rank",
          "score",
          "decision_rationale",
          "selection_rationale",
          "review_pass_id",
          "gloss_judgment",
          "sense_reviews"
        ],
        "sense_review_allowed_fields": [
          "sense_id",
          "boundary_action",
          "boundary_classification",
          "boundary_decision",
          "boundary_rationale",
          "semantic_rationale",
          "relation_decision",
          "relation_count",
          "relation_ids",
          "no_relation_rationale",
          "review_basis"
