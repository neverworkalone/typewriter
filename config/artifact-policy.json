      "candidate_record_id",
      "candidate_record_sha256",
      "decision",
      "selection_rank",
      "selection_score",
      "reviewed_record_sha256"
    ],
    "canonical_batch_binding_required_fields": [
      "source_id",
      "source_sha256",
      "artifact_sha256",
      "decision_row_sha256",
      "candidate_record_id",
      "candidate_record_sha256",
      "decision",
      "selection_rank",
      "selection_score",
      "reviewed_record_sha256"
    ],
    "gate_allowed_fields": [
