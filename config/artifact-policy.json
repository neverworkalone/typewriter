          "state",
          "topic",
          "particle",
          "predicate",
          "token_index",
          "topic_pos",
          "evidence_basis",
          "gloss_sha256",
          "rationale",
          "decision_source_id"
        ],
        "nested_allowed_fields": {
          "$.provenance": ["generator", "generator_version", "generation_pass_id", "verification_pass_id", "human_reviewed", "authoring_note"],
          "$.candidate_source": ["source_id", "identity_sha256", "identity_count", "candidate_records_sha256"],
          "$.selection": ["policy", "capacity", "imported", "reserve", "score_basis"],
          "$.decisions.*": ["candidate_record_id", "inventory_id", "candidate_record_sha256", "decision", "rank", "score", "decision_rationale", "selection_rationale", "review_pass_id", "gloss_judgment", "sense_reviews"],
          "$.decisions.*.sense_reviews.*": ["sense_id", "boundary_action", "boundary_classification", "boundary_decision", "boundary_rationale", "semantic_rationale", "relation_decision", "relation_count", "relation_ids", "no_relation_rationale", "review_basis"],
          "$.decisions.*.sense_reviews.*.review_basis": ["topic_analysis", "topic_analyses"],
          "$.decisions.*.sense_reviews.*.review_basis.topic_analysis": ["status", "state", "topic", "particle", "predicate", "token_index", "topic_pos", "evidence_basis", "gloss_sha256", "rationale", "decision_source_id"],
          "$.decisions.*.sense_reviews.*.review_basis.topic_analyses.*": ["status", "state", "topic", "particle", "predicate", "token_index", "topic_pos", "evidence_basis", "gloss_sha256", "rationale", "decision_source_id"],
          "$.review": ["review_pass_id", "reviewer", "status", "candidate_count", "reviewed_candidate_count", "method", "criteria", "decision_counts", "admission_rule", "prior_generator_replaced", "prior_generator_verification_pass_id", "counts"],
          "$.review.decision_counts": ["included", "corrected", "held", "rejected", "deferred"],
          "$.review.counts": ["included", "corrected", "held", "rejected", "deferred"],
          "$.candidate_records.*": ["id", "record_type", "role", "candidate_id", "lemma", "search_forms", "senses"],
          "$.candidate_records.*.senses.*": ["id", "pos", "gloss"]
