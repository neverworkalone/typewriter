      "scope",
      "canonical_records_sha256",
      "record_count",
      "sense_count",
      "covered_record_count",
      "covered_sense_count",
      "coverage_complete",
      "review_complete",
      "corrected_record_count"
    ],
    "closed_contracts": {
      "admission_manifest": {
        "contract_versions": [
          "lexical-batch-admission-v2"
        ],
        "allowed_fields": [
          "schema_version",
          "contract_version",
          "artifact_id",
          "issue",
          "parent_issue",
          "grandparent_issue",
          "batch_id",
          "authorization",
          "target",
          "base",
          "actual",
          "decisions",
          "verification",
          "gate",
          "gate_evidence",
          "gate_evidence_sha256",
          "sources",
          "promotion",
          "provenance"
        ],
        "nested_allowed_fields": {
          "$.authorization": ["kind", "issue", "decision", "human_editorial_review_complete", "generation_pass_id", "verification_pass_id"],
          "$.target": ["net_start_increase", "cumulative_start_target", "candidate_buffer", "selection_slot_count", "candidate_identity_count"],
          "$.base": ["canonical_directory_sha256", "inventory_sha256", "seed_sha256", "promotion_ledger_sha256", "summary"],
          "$.base.summary": ["record_count", "start_count", "reference_only_count", "sense_count", "relation_count", "expression_count"],
          "$.actual": ["record_count", "start_count", "reference_only_count", "sense_count", "relation_count", "expression_count"],
          "$.decisions": ["included", "corrected", "held", "rejected", "deferred", "processed_start_count", "imported_start_count", "deferred_denominator_excluded"],
          "$.verification": ["review_mode", "human_editorial_review_complete", "agent_generated_provenance", "generation_pass_id", "verification_pass_id", "candidate_source_id", "candidate_identity_count", "raw_material_excluded", "source_bound_semantic_decisions"],
