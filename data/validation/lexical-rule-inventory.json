        "symbol": "canonical record schema"
      },
      "historical_sources": [
        "M2"
      ],
      "applies_to": "every canonical and prospective record",
      "disposition": "retained-common"
    },
    {
      "id": "canonical-jsonl-read-and-normalization",
      "title": "Canonical JSONL parsing and normalized source records",
      "classification": "dictionary-wide invariant",
      "implementation": {
        "path": "scripts/validate/canonical-jsonl.mjs",
        "symbol": "readCanonicalRecords"
      },
      "historical_sources": [
        "M2",
        "normalization"
      ],
      "applies_to": "every canonical input and clean-checkout validation",
      "disposition": "retained-common"
    },
    {
      "id": "dataset-reference-and-relation-integrity",
      "title": "Record, sense, reference-closure, and relation integrity",
      "classification": "dictionary-wide invariant",
      "implementation": {
        "path": "scripts/validate/dataset-integrity.mjs",
        "symbol": "validateDatasetRecords"
      },
      "historical_sources": [
        "M2",
        "M5 relation admission"
      ],
      "applies_to": "every canonical and prospective dataset",
      "disposition": "retained-common"
    },
    {
