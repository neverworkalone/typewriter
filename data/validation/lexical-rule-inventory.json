      "title": "Lemma, normalized search-form, record-type, and POS identity",
      "classification": "dictionary-wide invariant",
      "implementation": {
        "path": "scripts/validate/lexical-quality.mjs",
        "symbol": "validateLexicalRecord and auditCanonicalLexicalQuality"
      },
      "historical_sources": [
        "M2",
        "M4",
        "M5"
      ],
      "applies_to": "every existing, corrected, and newly proposed record",
      "disposition": "consolidated-common"
    },
    {
      "id": "writer-facing-gloss-quality",
      "title": "Atomic, useful, non-placeholder gloss quality",
      "classification": "dictionary-wide invariant",
      "implementation": {
        "path": "scripts/validate/lexical-quality.mjs",
        "symbol": "inspectGlossQuality and recordQualityFindings"
      },
      "historical_sources": [
        "M2",
        "M5 editorial review"
      ],
      "applies_to": "every sense in canonical and prospective data",
      "disposition": "consolidated-common"
    },
    {
