      "title": "Sensory, affective, state, action, literal, and figurative boundaries",
      "classification": "dictionary-wide invariant",
      "implementation": {
        "path": "scripts/validate/lexical-quality.mjs",
        "symbol": "inspectWriterDomainEvidence and inspectGlossConnectors"
      },
      "historical_sources": [
        "M5 sense preflight",
        "M5-11 semantic review"
      ],
      "applies_to": "every sense regardless of batch or record identifier",
      "disposition": "consolidated-common"
    },
    {
      "id": "semantic-audit-coverage-and-binding",
      "title": "Source-bound per-sense semantic audit coverage",
      "classification": "admission invariant",
      "implementation": {
        "path": "scripts/validate/semantic-audit.mjs",
        "symbol": "validateSemanticAuditCoverage and validateSemanticReviewArtifact"
      },
      "historical_sources": [
        "M5-10",
        "M5-11"
      ],
      "applies_to": "every admission and corrected canonical snapshot",
      "disposition": "consolidated-common"
    },
    {
      "id": "deterministic-sqlite-build",
      "title": "Canonical JSONL to deterministic SQLite projection",
      "classification": "dictionary-wide invariant",
      "implementation": {
        "path": "scripts/build/dictionary.mjs",
        "symbol": "dictionary build pipeline"
      },
      "historical_sources": [
        "M2",
        "M4"
      ],
      "applies_to": "every canonical revision",
      "disposition": "retained-common"
    },
    {
      "id": "production-state-transitions",
      "title": "Shared candidate-to-admission production state machine",
      "classification": "admission invariant",
      "implementation": {
        "path": "scripts/batch/lexical-production-state.mjs",
        "symbol": "LEXICAL_PRODUCTION_STAGE_IDS and validateLexicalProductionState"
      },
      "historical_sources": [
        "M5-11B"
      ],
      "applies_to": "generic, historical M5, and future lexical admissions",
      "disposition": "new-common"
    },
    {
      "id": "production-review-selection-orchestration",
      "title": "Shared semantic review, decision, selection, and prospective binding",
      "classification": "admission invariant",
      "implementation": {
        "path": "scripts/batch/lexical-production.mjs",
        "symbol": "validateLexicalProduction"
      },
      "historical_sources": [
        "M5 batch validators",
        "M5-11B"
      ],
      "applies_to": "every candidate pool and correction set",
      "disposition": "consolidated-common"
    },
    {
      "id": "complete-prospective-admission",
      "title": "Complete-base, complete-prospective, audit-bound admission gate",
      "classification": "admission invariant",
      "implementation": {
        "path": "scripts/batch/lexical-admission.mjs",
        "symbol": "validateLexicalAddition"
      },
      "historical_sources": [
        "M5-11A",
        "M5-11B"
      ],
      "applies_to": "all new and corrected records before promotion",
      "disposition": "consolidated-common"
    },
    {
      "id": "legacy-batch-local-lexical-quality-forks",
      "title": "Per-batch copies of dictionary-wide lexical quality rules",
      "classification": "obsolete/duplicate",
      "implementation": {
        "path": "none",
        "symbol": "removed in favor of lexical-quality.mjs"
      },
      "historical_sources": [
        "M5 batch review validators"
      ],
      "applies_to": "no active path",
      "disposition": "forbidden; use the shared lexical-quality contract"
    },
    {
      "id": "legacy-direct-canonical-append",
      "title": "Direct canonical append without complete prospective audit",
      "classification": "obsolete/duplicate",
      "implementation": {
        "path": "none",
        "symbol": "forbidden by lexical-admission and promotion boundaries"
      },
      "historical_sources": [
        "pre-M5 import practice"
      ],
      "applies_to": "no active path",
      "disposition": "forbidden; promotion must consume an admitted prospective dataset"
    },
    {
      "id": "legacy-self-declared-semantic-pass",
      "title": "Self-declared semantic pass without per-sense source-bound evidence",
      "classification": "obsolete/duplicate",
      "implementation": {
        "path": "none",
        "symbol": "replaced by semantic-audit.mjs review_basis"
      },
      "historical_sources": [
        "pre-PR #120 audit artifacts"
      ],
      "applies_to": "no active path",
      "disposition": "forbidden; deterministic coverage cannot manufacture semantic decisions"
    }
  ]
