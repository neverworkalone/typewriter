{
  "glosses": [
    {
      "sense_id": "w503551-s3",
      "gloss": "혁명을 일으킨 세력이 구성한 정부를 가리키는 줄임말."
    },
    {
      "sense_id": "w370816-s2",
      "gloss": "아악기에 속하는 타악기의 하나. 통이 긴 북으로, 나무틀 위에 놓고 친다."
    },
    {
      "sense_id": "w506196-s1",
      "gloss": "예전에, 할아버지의 할아버지를 높여 이르던 말."
    },
    {
      "sense_id": "w371699-s1",
      "gloss": "오동나무와 밤나무를 붙여 만든 통에 명주실 여섯 줄을 걸고 술대로 연주하는 우리나라 현악기."
    },
    {
      "sense_id": "w369302-s1",
      "gloss": "중국 삼국 시대 촉한의 첫 황제 유비의 자."
    },
    {
      "sense_id": "w367212-s1",
      "gloss": "깊고 묘한 도라는 뜻으로, 수행을 쌓아 부처가 되는 길을 이르는 말."
    },
    {
      "sense_id": "w367809-s1",
      "gloss": "한 해의 네 철 가운데 넷째 철로, 가을과 봄 사이의 추운 계절."
    },
    {
      "sense_id": "w370764-s2",
      "gloss": "처마 끝 등에 달아 놓아 줄을 당기면 소리가 나는 방울."
    },
    {
      "sense_id": "w369353-s1",
      "gloss": "교리가 깊고 묘하며 열반에 드는 길이라는 뜻으로 불교를 이르는 말."
    },
    {
      "sense_id": "w372463-s1",
      "gloss": "물건을 얹어 두도록 까치발을 받쳐 벽에 단 긴 널빤지."
    },
    {
      "sense_id": "w377514-s1",
      "gloss": "정약전이 1814년에 지은 조선의 어류학서."
    },
    {
      "sense_id": "w371134-s1",
      "gloss": "가야금이나 거문고 따위 현악기의 줄."
    },
    {
      "sense_id": "w372337-s1",
      "gloss": "알코올 성분이 있어 마시면 취하는 음료를 불교에서 이르는 말."
    },
    {
      "sense_id": "w372598-s1",
      "gloss": "출가하여 구족계를 받은 남자 승려를 높여 이르는 말."
    },
    {
      "sense_id": "w368898-s1",
      "gloss": "삼식의 하나로, 모든 법의 종자를 간직하고 만법 연기의 근본이 되는 심식."
    },
    {
      "sense_id": "w370471-s1",
      "gloss": "상현이나 하현을 이르는, 활시위 모양의 달."
    },
    {
      "sense_id": "w376034-s1",
      "gloss": "한 해의 네 철 가운데 넷째 철로, 가을과 봄 사이의 추운 계절."
    },
    {
      "sense_id": "w369071-s1",
      "gloss": "죽은 사람을 좋은 세계에 태어나게 하려고 부처 앞에 공양하는 재."
    },
    {
      "sense_id": "w373699-s2",
      "gloss": "임용 자격이 있는 사람을 근무지나 배속 부대에서 별도 교육 없이 바로 장교로 임관시키는 일."
    }
  ],
