{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10a-relation-calibration.schema.json",
  "title": "Typewriter M5-10A relation-generation calibration result",
  "description": "Source-bound output, human audit, and fixed-gate evidence for twenty unlabelled, noncanonical relation requests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "process_revision",
    "canonical_mutation",
    "source",
    "canonical_snapshot",
    "calibration",
    "raw_proposals",
    "generation_suppressions"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_id": { "type": "string", "pattern": "^m5-10a-relation-calibration-[0-9]{8}$" },
    "process_revision": { "const": "m5-10a-relation-generation-v2" },
    "canonical_mutation": { "const": false },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture",
        "fixture_sha256",
        "canonical_directory",
        "canonical_directory_sha256",
        "expansion_plan",
        "expansion_plan_sha256",
        "relation_calibration_timing",
        "relation_calibration_timing_sha256"
      ],
      "properties": {
        "fixture": { "const": "tests/fixtures/m5-10a-relation-generation-calibration.json" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_directory": { "const": "data/canonical" },
        "canonical_directory_sha256": { "$ref": "#/$defs/sha256" },
        "expansion_plan": { "const": "data/batches/m5-8-expansion-plan.json" },
        "expansion_plan_sha256": { "$ref": "#/$defs/sha256" },
        "relation_calibration_timing": { "const": "data/batches/m5-10a-relation-calibration-timing.json" },
        "relation_calibration_timing_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "canonical_snapshot": { "$ref": "#/$defs/snapshot" },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "preflight", "generation", "timing", "audit", "fixed_gate"],
      "properties": {
        "case_count": { "const": 20 },
        "preflight": { "$ref": "#/$defs/preflightResult" },
        "generation": { "$ref": "#/$defs/generationResult" },
        "timing": { "$ref": "#/$defs/timingResult" },
        "audit": { "$ref": "#/$defs/audit" },
        "fixed_gate": { "$ref": "#/$defs/fixedGate" }
      }
    },
    "raw_proposals": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "$ref": "#/$defs/generatedCandidate" }
    },
    "generation_suppressions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/suppressedCandidate" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "start_count", "reference_only_count", "sense_count", "relation_count", "expression_count"],
      "properties": {
        "record_count": { "const": 620 },
        "start_count": { "const": 578 },
        "reference_only_count": { "const": 42 },
        "sense_count": { "const": 743 },
        "relation_count": { "const": 467 },
        "expression_count": { "const": 39 }
      }
    },
    "preflightResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "case_count", "evidence_case_count", "unresolved_boundary_count", "duplicate_evidence_count", "checked_boundary_counts"],
      "properties": {
        "status": { "const": "complete" },
        "case_count": { "const": 20 },
        "evidence_case_count": { "const": 20 },
        "unresolved_boundary_count": { "const": 0 },
        "duplicate_evidence_count": { "const": 0 },
        "checked_boundary_counts": { "$ref": "#/$defs/boundaryCounts" }
      }
    },
    "boundaryCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical-figurative", "homonym-pos", "sensory-emotion-state-action", "directional-symmetry", "compound-spaced-phrase", "word-idiom"],
      "properties": {
        "physical-figurative": { "type": "integer", "minimum": 1 },
        "homonym-pos": { "type": "integer", "minimum": 1 },
        "sensory-emotion-state-action": { "type": "integer", "minimum": 1 },
        "directional-symmetry": { "type": "integer", "minimum": 1 },
        "compound-spaced-phrase": { "type": "integer", "minimum": 1 },
        "word-idiom": { "type": "integer", "minimum": 1 }
      }
    },
    "generationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_count", "raw_proposal_count", "generation_suppressed_count", "pre_screen_noise_count", "noise_rate_of_raw_proposals", "suppressed_category_counts"],
      "properties": {
        "request_count": { "const": 20 },
        "raw_proposal_count": { "const": 13 },
        "generation_suppressed_count": { "const": 7 },
        "pre_screen_noise_count": { "const": 0 },
        "noise_rate_of_raw_proposals": { "const": 0 },
        "suppressed_category_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["incidental-co-occurrence", "generic-result-or-reaction", "arbitrary-modifier-or-place", "broad-common-category", "unsupported-cross-sensory", "sense-target-type-error", "direction-mismatch"],
          "properties": {
            "incidental-co-occurrence": { "const": 1 },
            "generic-result-or-reaction": { "const": 1 },
            "arbitrary-modifier-or-place": { "const": 1 },
            "broad-common-category": { "const": 1 },
            "unsupported-cross-sensory": { "const": 1 },
            "sense-target-type-error": { "const": 1 },
            "direction-mismatch": { "const": 1 }
          }
        }
      }
    },
    "timingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "timing_source", "timing_source_sha256", "processed_start_count", "editor_seconds", "editor_seconds_per_processed_start", "unmeasured_pass_count", "machine_validation_excluded_from_editor_seconds"],
      "properties": {
        "status": { "const": "complete" },
        "timing_source": { "const": "data/batches/m5-10a-relation-calibration-timing.json" },
        "timing_source_sha256": { "$ref": "#/$defs/sha256" },
        "processed_start_count": { "const": 20 },
        "editor_seconds": { "type": "number", "minimum": 0 },
        "editor_seconds_per_processed_start": { "type": "number", "minimum": 0, "maximum": 12 },
        "unmeasured_pass_count": { "const": 0 },
        "machine_validation_excluded_from_editor_seconds": { "const": true }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "independent", "reviewed_case_count", "reviewed_raw_proposal_count", "human_admitted_count", "human_rejected_count", "correction_count", "correction_rate", "confirmed_noise_count", "open_blocker_count", "case_reviews", "findings"],
      "properties": {
        "status": { "const": "complete" },
        "independent": { "const": true },
        "reviewed_case_count": { "const": 20 },
        "reviewed_raw_proposal_count": { "const": 13 },
        "human_admitted_count": { "const": 13 },
        "human_rejected_count": { "const": 0 },
        "correction_count": { "const": 0 },
        "correction_rate": { "const": 0 },
        "confirmed_noise_count": { "const": 0 },
        "open_blocker_count": { "const": 0 },
        "case_reviews": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/caseReview" }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "caseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "outcome", "admission", "noise_assessment", "correction", "note"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^m5-10a-cal-[0-9]{3}$" },
        "outcome": { "enum": ["raw-proposal", "generation-suppressed"] },
        "admission": { "enum": ["admitted", "not-applicable", "rejected"] },
        "noise_assessment": { "enum": ["clean", "noise", "not-a-proposal"] },
        "correction": { "enum": ["none", "corrected"] },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "status": { "const": "closed" },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "fixedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "relation_noise_rate_max", "editor_seconds_per_processed_start_max", "correction_rate_max", "unmeasured_timing_passes_max", "open_audit_blockers_max"],
      "properties": {
        "status": { "const": "passed" },
        "relation_noise_rate_max": { "const": 0.25 },
        "editor_seconds_per_processed_start_max": { "const": 12 },
        "correction_rate_max": { "const": 0.5 },
        "unmeasured_timing_passes_max": { "const": 0 },
        "open_audit_blockers_max": { "const": 0 }
      }
    },
    "generatedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_sense", "relation", "direction"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^m5-10a-cal-[0-9]{3}$" },
        "source_sense": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" },
        "relation": { "$ref": "#/$defs/relation" },
        "direction": { "$ref": "#/$defs/direction" }
      }
    },
    "suppressedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "category"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^m5-10a-cal-[0-9]{3}$" },
        "category": { "enum": ["incidental-co-occurrence", "generic-result-or-reaction", "arbitrary-modifier-or-place", "broad-common-category", "unsupported-cross-sensory", "sense-target-type-error", "direction-mismatch"] }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "target_sense", "type"],
      "properties": {
        "target": { "type": "string", "pattern": "^[wr][0-9]{3,}$" },
        "target_sense": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" },
        "type": { "enum": ["direct", "near", "mood", "scene", "sensory", "action", "association", "antonym"] }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" },
        "to": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" }
      }
    }
  }
}
