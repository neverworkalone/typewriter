{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10a-wave-a2-audit-decisions.schema.json",
  "title": "Typewriter M5-10A Wave A2 supplied audit decisions",
  "description": "A separately authored audit result consumed by the audit recorder. It is not a completed audit claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "batch_id",
    "source_kind",
    "actor_kind",
    "actor_id",
    "session_id",
    "created_at",
    "finalized_at",
    "editorial_input_id",
    "reviewed_staging_sha256",
    "reviewed_record_ids",
    "relation_reviews",
    "findings",
    "note"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_id": { "type": "string", "pattern": "^m5-10a-wave-a2-audit-decisions-[0-9]{8}$" },
    "batch_id": { "const": "m5-10-wave-a2-20260909" },
    "source_kind": { "enum": ["human-authored", "codex-authored"] },
    "actor_kind": { "enum": ["human", "codex"] },
    "actor_id": { "type": "string", "pattern": "\\S" },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "finalized_at": { "type": "string", "format": "date-time" },
    "editorial_input_id": { "type": "string", "pattern": "^m5-10a-wave-a2-editorial-input-[0-9]{8}$" },
    "reviewed_staging_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewed_record_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^w[0-9]{3,}$" }
    },
    "relation_reviews": {
      "type": "array",
      "items": { "type": "object" }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "note": { "type": "string", "pattern": "\\S" }
  }
}
