{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10a-wave-a2-audit-input.schema.json",
  "title": "Typewriter M5-10A Wave A2 audit pass input",
  "description": "A separately recorded audit pass. Only a verified, separate pass may claim an independent completed audit, and the completed audit binds the final reviewed canonical staging digest. The same Codex actor may perform both passes when the session and artifact are distinct.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "batch_id",
    "source_kind",
    "provenance",
    "editorial_input_id",
    "auditor_id",
    "independent",
    "created_at",
    "reviewed_record_ids",
    "relation_reviews",
    "status",
    "findings",
    "note"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "audit_id": { "type": "string", "pattern": "^m5-10a-wave-a2-audit-[0-9]{8}$" },
    "batch_id": { "type": "string", "pattern": "^m5-[0-9]+-[a-z0-9][a-z0-9-]*$" },
    "source_kind": { "enum": ["human-authored", "codex-authored", "unverified-draft"] },
    "provenance": { "$ref": "#/$defs/provenance" },
    "editorial_input_id": { "type": "string", "pattern": "^m5-10a-wave-a2-editorial-input-[0-9]{8}$" },
    "auditor_id": { "type": "string", "pattern": "\\S" },
    "independent": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "reviewed_record_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^w[0-9]{3,}$" }
    },
    "relation_reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationReview" }
    },
    "reviewed_staging_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timing_artifact": { "$ref": "#/$defs/timingArtifact" },
    "decision_artifact": { "$ref": "#/$defs/decisionArtifact" },
    "status": { "enum": ["incomplete", "complete"] },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "note": { "type": "string", "pattern": "\\S" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source_kind": { "const": "human-authored" } }
      },
      "then": {
        "properties": { "status": { "const": "complete" } },
        "required": ["reviewed_staging_sha256", "timing_artifact", "decision_artifact"]
      }
    },
    {
      "if": {
        "properties": { "source_kind": { "const": "codex-authored" } }
      },
      "then": {
        "properties": { "status": { "const": "complete" } },
        "required": ["reviewed_staging_sha256", "timing_artifact", "decision_artifact"]
      }
    },
    {
      "if": {
        "properties": { "source_kind": { "const": "unverified-draft" } }
      },
      "then": {
        "properties": { "status": { "const": "incomplete" } },
        "not": { "required": ["reviewed_staging_sha256"] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "complete" } } },
      "then": { "required": ["completed_at"] }
    },
    {
      "if": { "properties": { "status": { "const": "incomplete" } } },
      "then": { "not": { "required": ["completed_at"] } }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_status",
        "actor_kind",
        "actor_id",
        "session_id",
        "artifact",
        "sha256",
        "note"
      ],
      "properties": {
        "verification_status": { "enum": ["verified", "unverified"] },
        "actor_kind": { "enum": ["human", "codex", "unknown"] },
        "actor_id": { "type": "string", "pattern": "\\S" },
        "session_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "artifact": {
          "type": ["string", "null"],
          "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.(json|jsonl)$"
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "timingArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "completed_at"],
      "properties": {
        "path": { "type": "string", "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.(json|jsonl)$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "decisionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "created_at", "finalized_at"],
      "properties": {
        "path": { "type": "string", "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.(json|jsonl)$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "created_at": { "type": "string", "format": "date-time" },
        "finalized_at": { "type": "string", "format": "date-time" }
      }
    },
    "relationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "relation_id",
        "source_sense",
        "target_sense",
        "review_status",
        "relation_type",
        "decision"
      ],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "relation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "source_sense": { "type": "string", "pattern": "^w[0-9]{3,}-s[0-9]+$" },
        "target_sense": { "type": "string", "pattern": "^w[0-9]{3,}-s[0-9]+$" },
        "review_status": { "enum": ["unreviewed", "reviewed"] },
        "relation_type": { "enum": ["direct", "near", "mood", "scene", "sensory", "action", "association", "antonym"] },
        "decision": { "enum": ["pending", "admit", "reject"] },
        "basis": { "$ref": "#/$defs/relationBasis" }
      },
      "allOf": [
        {
          "if": { "properties": { "review_status": { "const": "reviewed" } } },
          "then": { "required": ["basis"] }
        },
        {
          "if": { "properties": { "review_status": { "const": "unreviewed" } } },
          "then": { "not": { "required": ["basis"] } }
        }
      ]
    },
    "relationBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facets", "source_observation", "target_observation", "difference"],
      "properties": {
        "facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "source_observation": { "type": "string", "pattern": "\\S" },
        "target_observation": { "type": "string", "pattern": "\\S" },
        "difference": { "type": "string", "pattern": "\\S" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "severity", "status", "evidence_refs", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "category": { "enum": ["blocker", "relation-noise", "sense", "reference-closure", "timing-measurement", "provenance"] },
        "severity": { "enum": ["blocker", "warning", "info"] },
        "status": { "enum": ["open", "resolved"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "note": { "type": "string", "pattern": "\\S" }
      }
    }
  }
}
