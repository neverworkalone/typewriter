{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10a-wave-a2-audit-input.schema.json",
  "title": "Typewriter M5-10A Wave A2 independent audit input",
  "description": "A separately authored audit of the A2 editorial input and relation admissions. Counts, gate status, and resolved claims are derived only after this input is checked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "batch_id",
    "source_kind",
    "editorial_input_id",
    "auditor_id",
    "independent",
    "audited_at",
    "reviewed_record_ids",
    "relation_reviews",
    "status",
    "findings",
    "note"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "audit_id": { "type": "string", "pattern": "^m5-10a-wave-a2-audit-[0-9]{8}$" },
    "batch_id": { "type": "string", "pattern": "^m5-[0-9]+-[a-z0-9][a-z0-9-]*$" },
    "source_kind": { "const": "human-authored" },
    "editorial_input_id": { "type": "string", "pattern": "^m5-10a-wave-a2-editorial-input-[0-9]{8}$" },
    "auditor_id": { "type": "string", "pattern": "\\S" },
    "independent": { "const": true },
    "audited_at": { "type": "string", "format": "date-time" },
    "reviewed_record_ids": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^w[0-9]{3,}$" }
    },
    "relation_reviews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relationReview" }
    },
    "status": { "enum": ["incomplete", "complete"] },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "note": { "type": "string", "pattern": "\\S" }
  },
  "$defs": {
    "relationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "relation_id",
        "source_sense",
        "target_sense",
        "relation_type",
        "decision",
        "review_note"
      ],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "relation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "source_sense": { "type": "string", "pattern": "^w[0-9]{3,}-s[0-9]+$" },
        "target_sense": { "type": "string", "pattern": "^w[0-9]{3,}-s[0-9]+$" },
        "relation_type": { "enum": ["direct", "near", "mood", "scene", "sensory", "action", "association", "antonym"] },
        "decision": { "enum": ["admit", "reject"] },
        "review_note": { "type": "string", "pattern": "\\S" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "severity", "status", "evidence_refs", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "category": { "enum": ["blocker", "relation-noise", "sense", "reference-closure", "timing-measurement"] },
        "severity": { "enum": ["blocker", "warning", "info"] },
        "status": { "enum": ["open", "resolved"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "note": { "type": "string", "pattern": "\\S" }
      }
    }
  }
}
