{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10c-timing.schema.json",
  "title": "Typewriter M5-10C editor-time recorder output",
  "description": "Recorder-owned current-clock timing for editorial judgment and independent post-freeze audit. Producer execution time is stored separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "batch_id", "timing_kind", "measurement_kind", "recorder_version", "recording_source", "recorder_command", "session_id", "started_at", "status", "passes", "events", "recording_proof_sha256"],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_id": { "type": "string", "pattern": "^m5-10c-(editorial|audit)-timing-20260910$" },
    "batch_id": { "const": "m5-10c-editor-time-recovery-20260910" },
    "timing_kind": { "enum": ["editorial", "post-freeze-audit"] },
    "measurement_kind": { "const": "editor-judgment" },
    "recorder_version": { "const": "m5-10c-timing-recorder-v1" },
    "recording_source": { "const": "timing-recorder-v1" },
    "recorder_command": { "const": "node scripts/batch/record-m5-10c-timing.mjs" },
    "session_id": { "$ref": "#/$defs/uuid" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["in-progress", "complete"] },
    "proposal_sha256": { "$ref": "#/$defs/sha256" },
    "editorial_session_id": { "$ref": "#/$defs/uuid" },
    "audit_session_id": { "$ref": "#/$defs/uuid" },
    "editorial_decisions_sha256": { "$ref": "#/$defs/sha256" },
    "editorial_finalized_at": { "type": "string", "format": "date-time" },
    "canonical_directory_sha256": { "$ref": "#/$defs/sha256" },
    "inventory_sha256": { "$ref": "#/$defs/sha256" },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pass" }
    },
    "events": { "type": "array", "items": { "type": "object" } },
    "note": { "type": "string", "pattern": "\\S" },
    "recording_proof_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^(target-preparation|initial-review|feedback-fixes|final-audit|held-rejected|post-freeze-audit)$" },
        "status": { "enum": ["unmeasured", "in-progress", "complete"] },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "editor_seconds": { "type": "number", "minimum": 0 },
        "wall_clock_seconds": { "type": "number", "minimum": 0 },
        "producer_seconds": { "type": "number", "minimum": 0 },
        "work_evidence": { "type": "object" }
      }
    }
  }
}
