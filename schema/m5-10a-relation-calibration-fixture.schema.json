{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10a-relation-calibration-fixture.schema.json",
  "title": "Typewriter M5-10A relation-generation calibration fixture",
  "description": "Twenty unreviewed, noncanonical relation requests. Runtime classification must derive from canonical sense content and direction, not labels supplied by this fixture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "process_revision",
    "canonical_artifact",
    "calibration_case_count",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "fixture_id": { "const": "m5-10a-relation-generation-calibration" },
    "process_revision": { "const": "m5-10a-relation-generation-v2" },
    "canonical_artifact": { "const": "data/canonical" },
    "calibration_case_count": { "const": 20 },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/calibrationCase" }
    }
  },
  "$defs": {
    "calibrationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_sense", "relation", "direction", "preflight"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^m5-10a-cal-[0-9]{3}$" },
        "source_sense": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" },
        "relation": { "$ref": "#/$defs/relation" },
        "direction": { "$ref": "#/$defs/direction" },
        "preflight": { "$ref": "#/$defs/preflight" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "target_sense", "type"],
      "properties": {
        "target": { "type": "string", "pattern": "^[wr][0-9]{3,}$" },
        "target_sense": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" },
        "type": {
          "enum": ["direct", "near", "mood", "scene", "sensory", "action", "association", "antonym"]
        }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" },
        "to": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "boundary_checks"],
      "properties": {
        "status": { "const": "complete" },
        "boundary_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "physical-figurative",
            "homonym-pos",
            "sensory-emotion-state-action",
            "directional-symmetry",
            "compound-spaced-phrase",
            "word-idiom"
          ],
          "properties": {
            "physical-figurative": { "$ref": "#/$defs/boundaryEvidence" },
            "homonym-pos": { "$ref": "#/$defs/boundaryEvidence" },
            "sensory-emotion-state-action": { "$ref": "#/$defs/boundaryEvidence" },
            "directional-symmetry": { "$ref": "#/$defs/boundaryEvidence" },
            "compound-spaced-phrase": { "$ref": "#/$defs/boundaryEvidence" },
            "word-idiom": { "$ref": "#/$defs/boundaryEvidence" }
          }
        }
      }
    },
    "boundaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "sense_ids", "observed_glosses", "observed_use", "source_note"],
      "properties": {
        "status": { "enum": ["checked", "not-applicable"] },
        "rationale": { "type": "string", "pattern": "\\S" },
        "sense_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[wr][0-9]{3,}-s[0-9]+$" }
        },
        "observed_glosses": {
          "type": "array",
          "items": { "type": "string", "pattern": "\\S" }
        },
        "observed_use": { "type": "string", "pattern": "\\S" },
        "source_note": { "type": "string", "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "checked" } } },
          "then": {
            "properties": {
              "sense_ids": { "type": "array", "minItems": 1 },
              "observed_glosses": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "not-applicable" } } },
          "then": {
            "properties": {
              "sense_ids": { "type": "array", "maxItems": 0 },
              "observed_glosses": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
