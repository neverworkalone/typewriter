{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/batch-manifest.schema.json",
  "title": "Typewriter reviewed batch manifest",
  "description": "Review metadata for a canonical import batch. Raw drafts and model responses are never stored here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "inventory_id",
    "inventory_revision",
    "generator",
    "generated_at",
    "review",
    "records"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "batch_id": {
      "type": "string",
      "pattern": "^m5-[0-9]+-[a-z0-9][a-z0-9-]*$"
    },
    "inventory_id": { "const": "m5-core-5k" },
    "inventory_revision": {
      "type": "string",
      "pattern": "^m5-[1-9][0-9]*$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "tool_version", "prompt_version"],
      "properties": {
        "model_id": { "type": "string", "pattern": "\\S" },
        "tool_version": { "type": "string", "pattern": "\\S" },
        "prompt_version": { "type": "string", "pattern": "\\S" },
        "draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer"],
      "properties": {
        "status": {
          "enum": ["unreviewed", "in-review", "complete"]
        },
        "reviewer": { "type": "string", "pattern": "\\S" },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_artifact": {
          "type": "string",
          "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.json$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_staging_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "semantic_audit_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sense_review": {
      "$ref": "#/$defs/senseReview"
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "type": "object",
            "properties": {
              "status": { "const": "complete" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "object",
            "required": ["completed_at"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "type": "object",
            "properties": {
              "status": { "enum": ["unreviewed", "in-review"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "object",
            "not": { "required": ["completed_at"] }
          }
        }
      }
    },
    {
      "if": {
        "required": ["measurement"],
        "properties": {
          "measurement": {
            "type": "object",
            "required": ["timing"],
            "properties": {
              "timing": {
                "type": "object",
                "required": ["contract_version"],
                "properties": {
                  "contract_version": { "enum": ["m5-10a-v1", "m5-10b-v2", "m5-10b-v3"] }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": ["sense_review"],
        "properties": {
          "sense_review": {
            "type": "object",
            "required": ["preflight"]
          }
        }
      }
    }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "role",
        "decision",
        "decision_note"
      ],
      "properties": {
        "source": {
          "enum": ["inventory", "reference-closure"]
        },
        "inventory_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "role": {
          "enum": ["start", "reference-only"]
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}$"
        },
        "proposal_canonical_id": {
          "type": "string",
          "pattern": "^w[0-9]{3,}$"
        },
        "decision": {
          "enum": ["included", "held", "rejected", "corrected", "deferred", "proposed"]
        },
        "proposal_decision": {
          "enum": ["included", "corrected"]
        },
        "proposal_corrected_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "corrected_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "related_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[wr][0-9]{3,}$"
          }
        },
        "decision_note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": { "const": "inventory" }
            }
          },
          "then": {
            "required": ["inventory_id"],
            "properties": {
              "role": { "const": "start" }
            },
            "not": { "required": ["related_to"] }
          }
        },
        {
          "if": {
            "properties": {
              "source": { "const": "reference-closure" }
            }
          },
          "then": {
            "required": ["related_to"],
            "properties": {
              "role": { "const": "reference-only" }
            },
            "not": { "required": ["inventory_id"] }
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "enum": ["included", "corrected"] }
            }
          },
          "then": {
            "required": ["canonical_id"]
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "enum": ["held", "rejected", "deferred"] }
            }
          },
          "then": {
            "not": { "required": ["canonical_id"] }
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "const": "proposed" }
            }
          },
          "then": {
            "required": ["proposal_canonical_id", "proposal_decision"],
            "not": {
              "anyOf": [
                { "required": ["canonical_id"] },
                { "required": ["corrected_fields"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "const": "proposed" },
              "proposal_decision": { "const": "corrected" }
            }
          },
          "then": {
            "required": ["proposal_corrected_fields"]
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "const": "proposed" },
              "proposal_decision": { "const": "included" }
            }
          },
          "then": {
            "not": { "required": ["proposal_corrected_fields"] }
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "const": "corrected" }
            }
          },
          "then": {
            "required": ["corrected_fields"]
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "enum": ["included", "held", "rejected", "deferred"] }
            }
          },
          "then": {
            "not": { "required": ["corrected_fields"] }
          }
        }
      ]
    },
    "senseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_start_count",
        "scoped_single_sense_count",
        "split_record_count",
        "split_canonical_ids",
        "note"
      ],
      "properties": {
        "status": { "enum": ["complete", "incomplete"] },
        "reviewed_start_count": { "type": "integer", "minimum": 0 },
        "scoped_single_sense_count": { "type": "integer", "minimum": 0 },
        "split_record_count": { "type": "integer", "minimum": 0 },
        "split_canonical_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[wr][0-9]{3,}$"
          }
        },
        "note": { "type": "string", "pattern": "\\S" },
        "preflight": { "$ref": "#/$defs/sensePreflight" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "relation_diff", "timing", "audit"],
      "properties": {
        "schema_version": { "const": "1" },
        "relation_diff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "sha256"],
          "properties": {
            "artifact": {
              "type": "string",
              "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.json$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "passes"],
          "properties": {
            "status": {
              "enum": ["complete", "incomplete"]
            },
            "contract_version": {
              "enum": ["m5-9a-v1", "m5-10a-v1", "m5-10b-v2", "m5-10b-v3"]
            },
            "measurement_kind": {
              "enum": ["editorial-time", "producer-throughput"]
            },
            "producer_seconds_per_selected_start_max": {
              "const": 1
            },
            "source_artifact": {
              "type": "string",
              "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.json$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "audit_source_artifact": {
              "type": "string",
              "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.json$"
            },
            "audit_source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "passes": {
              "type": "array",
              "minItems": 5,
              "items": { "$ref": "#/$defs/timingPass" }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "independent", "findings"],
          "properties": {
            "status": {
              "enum": ["complete", "incomplete"]
            },
            "independent": { "type": "boolean" },
            "source_artifact": {
              "type": "string",
              "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.json$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reviewed_staging_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "coverage": {
              "type": "object"
            },
            "findings": {
              "type": "array",
              "items": { "$ref": "#/$defs/auditFinding" }
            }
          }
        }
      }
    },
    "timingPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {
          "enum": [
            "target-preparation",
            "initial-review",
            "feedback-fixes",
            "final-audit",
            "held-rejected",
            "post-freeze-audit",
            "post-review-audit",
            "post-review-fixes"
          ]
        },
        "status": {
          "enum": ["complete", "partial", "in-progress", "unmeasured"]
        },
        "cycle": {
          "type": "integer",
          "minimum": 1,
          "description": "One-based feedback cycle number for repeated post-review passes. Omit it for the first legacy follow-up pass."
        },
        "feedback_received_at": {
          "type": "string",
          "format": "date-time",
          "description": "The recorded time when the review feedback that triggered this follow-up cycle arrived."
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "output_artifact_created_at": {
          "type": "string",
          "format": "date-time"
        },
        "wall_clock_seconds": {
          "type": "number",
          "minimum": 0
        },
        "editor_seconds": {
          "type": "number",
          "minimum": 0
        },
        "producer_seconds": {
          "type": "number",
          "minimum": 0
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "audit_session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "reviewed_staging_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recording_source": {
          "enum": ["timing-recorder-v1", "timing-recorder-v2", "timing-recorder-v3", "timing-recorder-v4", "timing-recorder-v5", "timing-recorder-v6"]
        },
        "work_evidence": {
          "oneOf": [
            { "$ref": "#/$defs/legacyTimingWorkEvidence" },
            { "$ref": "#/$defs/timingWorkEvidence" }
          ]
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "legacyTimingWorkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_kind", "unit_count", "unit_ids", "before_sha256", "after_sha256", "note"],
      "properties": {
        "unit_kind": {
          "enum": ["selected-target", "boundary-check", "sense-correction", "final-audit-item", "buffer-decision", "post-freeze-audit-item"]
        },
        "unit_count": {
          "type": "integer",
          "minimum": 1
        },
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "before_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_artifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "output_artifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "work_event_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "timingWorkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_kind", "unit_count", "unit_ids", "work_event_ids", "before_sha256", "after_sha256", "input_artifact", "output_artifact", "work_log", "note"],
      "properties": {
        "unit_kind": {
          "enum": ["selected-target", "boundary-check", "sense-correction", "final-audit-item", "buffer-decision", "post-freeze-audit-item"]
        },
        "unit_count": {
          "type": "integer",
          "minimum": 1
        },
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "work_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "before_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_artifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "output_artifact": {
          "$ref": "#/$defs/artifactReference"
        },
        "work_log": {
          "$ref": "#/$defs/artifactReference"
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "\\S" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "auditFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "severity", "status", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "\\S" },
        "category": {
          "enum": [
            "blocker",
            "relation-noise",
            "direct-replacement",
            "sense",
            "reference-closure",
            "timing-measurement",
            "provenance"
          ]
        },
        "severity": {
          "enum": ["blocker", "warning", "info"]
        },
        "status": {
          "enum": ["open", "resolved"]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "target_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^w[0-9]{3,}$" }
        },
        "defect": {
          "type": "string",
          "pattern": "\\S"
        },
        "remediation": {
          "type": "string",
          "pattern": "\\S"
        },
        "diff_evidence": {
          "type": "object",
          "minProperties": 3,
          "required": ["kind", "before", "after"],
          "properties": {
            "kind": { "type": "string", "pattern": "\\S" },
            "before": {},
            "after": {},
            "changed_fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "\\S" }
            }
          }
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "sensePreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["process_revision", "boundary_ids", "record_checkpoints"],
      "properties": {
        "process_revision": {
          "const": "m5-10a-process-correction-v1"
        },
        "boundary_ids": {
          "const": [
            "physical-figurative",
            "homonym-pos",
            "sensory-emotion-state-action",
            "directional-symmetry",
            "compound-spaced-phrase",
            "word-idiom"
          ]
        },
        "record_checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/senseRecordCheckpoint" }
        }
      }
    },
    "senseRecordCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_id",
        "status",
        "lemma_pos",
        "observed_sense_count",
        "observed_pos",
        "boundary_checks",
        "missing_boundary_ids",
        "note"
      ],
      "properties": {
        "inventory_id": { "type": "string", "pattern": "\\S" },
        "canonical_id": {
          "type": "string",
          "pattern": "^w[0-9]{3,}$"
        },
        "status": {
          "enum": ["complete", "held", "rejected", "deferred", "not-reviewed"]
        },
        "lemma_pos": {
          "enum": ["checked", "not-reviewed"]
        },
        "observed_sense_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_pos": {
          "type": "array",
          "items": {
            "enum": ["noun", "adjective", "verb", "expression"]
          }
        },
        "boundary_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "physical-figurative",
            "homonym-pos",
            "sensory-emotion-state-action",
            "directional-symmetry",
            "compound-spaced-phrase",
            "word-idiom"
          ],
          "properties": {
            "physical-figurative": { "$ref": "#/$defs/boundaryEvidence" },
            "homonym-pos": { "$ref": "#/$defs/boundaryEvidence" },
            "sensory-emotion-state-action": { "$ref": "#/$defs/boundaryEvidence" },
            "directional-symmetry": { "$ref": "#/$defs/boundaryEvidence" },
            "compound-spaced-phrase": { "$ref": "#/$defs/boundaryEvidence" },
            "word-idiom": { "$ref": "#/$defs/boundaryEvidence" }
          }
        },
        "missing_boundary_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "physical-figurative",
              "homonym-pos",
              "sensory-emotion-state-action",
              "directional-symmetry",
              "compound-spaced-phrase",
              "word-idiom"
            ]
          }
        },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "boundaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "sense_ids"],
      "properties": {
        "status": {
          "enum": ["checked", "not-applicable", "not-reviewed"]
        },
        "rationale": {
          "type": "string",
          "pattern": "\\S"
        },
        "sense_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[wr][0-9]{3,}-s[0-9]+$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "const": "checked" }
            }
          },
          "then": {
            "properties": {
              "sense_ids": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["not-applicable", "not-reviewed"] }
            }
          },
          "then": {
            "properties": {
              "sense_ids": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
