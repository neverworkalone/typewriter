{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/batch-manifest.schema.json",
  "title": "Typewriter reviewed batch manifest",
  "description": "Review metadata for a canonical import batch. Raw drafts and model responses are never stored here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "inventory_id",
    "inventory_revision",
    "generator",
    "generated_at",
    "review",
    "records"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "batch_id": {
      "type": "string",
      "pattern": "^m5-[0-9]+-[a-z0-9][a-z0-9-]*$"
    },
    "inventory_id": { "const": "m5-core-5k" },
    "inventory_revision": {
      "type": "string",
      "pattern": "^m5-[1-9][0-9]*$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "tool_version", "prompt_version"],
      "properties": {
        "model_id": { "type": "string", "pattern": "\\S" },
        "tool_version": { "type": "string", "pattern": "\\S" },
        "prompt_version": { "type": "string", "pattern": "\\S" },
        "draft_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer"],
      "properties": {
        "status": {
          "enum": ["unreviewed", "in-review", "complete"]
        },
        "reviewer": { "type": "string", "pattern": "\\S" },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "type": "object",
            "properties": {
              "status": { "const": "complete" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "object",
            "required": ["completed_at"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "type": "object",
            "properties": {
              "status": { "enum": ["unreviewed", "in-review"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "object",
            "not": { "required": ["completed_at"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "role",
        "decision",
        "decision_note"
      ],
      "properties": {
        "source": {
          "enum": ["inventory", "reference-closure"]
        },
        "inventory_id": {
          "type": "string",
          "pattern": "\\S"
        },
        "role": {
          "enum": ["start", "reference-only"]
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}$"
        },
        "decision": {
          "enum": ["included", "held", "rejected", "corrected"]
        },
        "corrected_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "related_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[wr][0-9]{3,}$"
          }
        },
        "decision_note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": { "const": "inventory" }
            }
          },
          "then": {
            "required": ["inventory_id"],
            "properties": {
              "role": { "const": "start" }
            },
            "not": { "required": ["related_to"] }
          }
        },
        {
          "if": {
            "properties": {
              "source": { "const": "reference-closure" }
            }
          },
          "then": {
            "required": ["related_to"],
            "properties": {
              "role": { "const": "reference-only" }
            },
            "not": { "required": ["inventory_id"] }
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "enum": ["included", "corrected"] }
            }
          },
          "then": {
            "required": ["canonical_id"]
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "enum": ["held", "rejected"] }
            }
          },
          "then": {
            "not": { "required": ["canonical_id"] }
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "const": "corrected" }
            }
          },
          "then": {
            "required": ["corrected_fields"]
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "enum": ["included", "held", "rejected"] }
            }
          },
          "then": {
            "not": { "required": ["corrected_fields"] }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "relation_diff", "timing", "audit"],
      "properties": {
        "schema_version": { "const": "1" },
        "relation_diff": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "sha256"],
          "properties": {
            "artifact": {
              "type": "string",
              "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.json$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "passes"],
          "properties": {
            "status": {
              "enum": ["complete", "incomplete"]
            },
            "passes": {
              "type": "array",
              "minItems": 5,
              "items": { "$ref": "#/$defs/timingPass" }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "independent", "findings"],
          "properties": {
            "status": {
              "enum": ["complete", "incomplete"]
            },
            "independent": { "type": "boolean" },
            "findings": {
              "type": "array",
              "items": { "$ref": "#/$defs/auditFinding" }
            }
          }
        }
      }
    },
    "timingPass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {
          "enum": [
            "target-preparation",
            "initial-review",
            "feedback-fixes",
            "final-audit",
            "held-rejected",
            "post-review-audit"
          ]
        },
        "status": {
          "enum": ["complete", "partial", "unmeasured"]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "wall_clock_seconds": {
          "type": "number",
          "minimum": 0
        },
        "editor_seconds": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "auditFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "severity", "status", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "\\S" },
        "category": {
          "enum": [
            "blocker",
            "relation-noise",
            "direct-replacement",
            "sense",
            "reference-closure"
          ]
        },
        "severity": {
          "enum": ["blocker", "warning", "info"]
        },
        "status": {
          "enum": ["open", "resolved"]
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
