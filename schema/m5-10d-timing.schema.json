{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10d-timing.schema.json",
  "title": "Typewriter M5-10D workload-bound timing",
  "description": "Recorder-owned timing whose editor, wall-clock, and producer durations are independently derived.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "batch_id", "timing_kind", "measurement_kind", "recorder_version", "recording_source", "recorder_command", "session_id", "started_at", "status", "workload_artifact", "workload_sha256", "proposal_sha256", "canonical_directory_sha256", "inventory_sha256", "passes", "events", "recording_proof_sha256"],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_id": { "type": "string", "pattern": "^m5-10d-(editorial|audit)-timing-20260912$" },
    "batch_id": { "const": "m5-10d-editor-time-recalibration-20260912" },
    "timing_kind": { "enum": ["editorial", "post-freeze-audit"] },
    "measurement_kind": { "const": "editor-judgment" },
    "recorder_version": { "const": "m5-10d-workload-timing-recorder-v1" },
    "recording_source": { "const": "workload-timing-recorder-v1" },
    "recorder_command": { "const": "node scripts/batch/record-m5-10d-timing.mjs" },
    "session_id": { "$ref": "#/$defs/uuid" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["in-progress", "complete"] },
    "workload_artifact": { "type": "string", "pattern": "\\S" },
    "workload_sha256": { "$ref": "#/$defs/sha256" },
    "proposal_sha256": { "$ref": "#/$defs/sha256" },
    "editorial_session_id": { "$ref": "#/$defs/uuid" },
    "audit_session_id": { "$ref": "#/$defs/uuid" },
    "editorial_decisions": { "type": "string", "pattern": "\\S" },
    "editorial_decisions_sha256": { "$ref": "#/$defs/sha256" },
    "editorial_finalized_at": { "type": "string", "format": "date-time" },
    "canonical_directory_sha256": { "$ref": "#/$defs/sha256" },
    "inventory_sha256": { "$ref": "#/$defs/sha256" },
    "passes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/pass" }
    },
    "events": { "type": "array", "items": { "type": "object" } },
    "note": { "type": "string", "pattern": "\\S" },
    "recording_proof_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "enum": ["target-preparation", "initial-review", "feedback-fixes", "final-verification", "held-rejected", "post-freeze-audit"] },
        "status": { "enum": ["unmeasured", "in-progress", "complete"] },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "work_status": { "enum": ["work", "zero-work"] },
        "editor_seconds": { "type": "number", "minimum": 0 },
        "wall_clock_seconds": { "type": "number", "minimum": 0 },
        "producer_seconds": { "type": "number", "minimum": 0 },
        "work_evidence": { "$ref": "#/$defs/workEvidence" }
      }
    },
    "workEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "expected_unit_ids", "actual_unit_ids", "unit_count", "expected_unit_set_sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "\\S" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "expected_unit_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^m5-10d-cal-[0-9]{3}$" } },
        "actual_unit_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^m5-10d-cal-[0-9]{3}$" } },
        "unit_count": { "type": "integer", "minimum": 0 },
        "expected_unit_set_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
