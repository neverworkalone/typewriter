{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/canonical-record.schema.json",
  "title": "Typewriter canonical record",
  "description": "The minimal canonical record shape. role preserves the historical start/reference-only editorial classification; it does not control direct-search eligibility for a valid in-scope lexical entry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_type",
    "role",
    "lemma",
    "search_forms",
    "senses"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[wr][0-9]{3,}$"
    },
    "record_type": {
      "type": "string",
      "enum": ["entry", "expression"]
    },
    "role": {
      "type": "string",
      "description": "Historical editorial classification retained for provenance and inventory reporting. Both values may be directly searchable when the record is lexically valid and in scope.",
      "enum": ["start", "reference-only"]
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^w[0-9]{3,}$"
    },
    "lemma": {
      "type": "string",
      "pattern": "\\S"
    },
    "search_forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "senses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sense"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "record_type": {
            "const": "entry"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "senses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pos": {
                "enum": ["noun", "adjective", "verb", "adverb"]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "record_type": {
            "const": "expression"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "senses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pos": {
                  "const": "expression"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pos", "gloss"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}-s[1-9][0-9]*$"
        },
        "pos": {
          "type": "string",
          "enum": ["noun", "adjective", "verb", "adverb", "expression"]
        },
        "gloss": {
          "type": "string",
          "pattern": "\\S"
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "type", "note"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}$"
        },
        "target_sense": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}-s[1-9][0-9]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "direct",
            "near",
            "antonym",
            "mood",
            "scene",
            "sensory",
            "action",
            "association"
          ]
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        },
        "relevance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9,
          "description": "Ordinal editorial priority for exploratory relations (1 highest, 9 peripheral). Not a distance score, probability or exact rank."
        }
      }
    }
  }
}
