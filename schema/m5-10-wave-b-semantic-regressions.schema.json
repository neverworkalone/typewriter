{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10-wave-b-semantic-regressions.schema.json",
  "title": "Typewriter M5-10 Wave B semantic regression corpus",
  "description": "Self-authored, curated semantic cases that must be checked during Wave B proposal preflight and final canonical validation. Synthetic cases exercise the contract without depending on a production record ID.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_id", "batch_id", "categories", "cases"],
  "properties": {
    "schema_version": { "const": "1" },
    "fixture_id": { "const": "m5-10-wave-b-semantic-regressions-v2" },
    "batch_id": { "const": "m5-10-wave-b-20260909" },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["homonym", "pos", "polysemy", "space-phrase"] }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "scope",
        "case_type",
        "canonical_id",
        "lemma",
        "boundary_id",
        "candidate_senses",
        "source_evidence",
        "expected_sense_count",
        "expected_sense_ids",
        "expected_glosses",
        "required_applicability",
        "required_decision",
        "contrast_pairs",
        "review_requirement"
      ],
      "properties": {
        "case_id": { "type": "string", "pattern": "^wave-b-sem-[0-9]{3,}$" },
        "scope": { "enum": ["wave-b-proposal", "canonical-regression", "synthetic-regression"] },
        "inventory_id": { "type": "string", "pattern": "^m5-[0-9]{3}$" },
        "case_type": { "enum": ["homonym", "pos", "polysemy", "space-phrase"] },
        "canonical_id": { "type": "string", "pattern": "^(?:w[0-9]{3,}|synthetic-[a-z0-9-]+)$" },
        "lemma": { "type": "string", "pattern": "\\S" },
        "boundary_id": {
          "enum": [
            "physical-figurative",
            "homonym-pos",
            "sensory-emotion-state-action",
            "directional-symmetry",
            "compound-spaced-phrase",
            "word-idiom"
          ]
        },
        "candidate_senses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/candidateSense" }
        },
        "source_evidence": { "$ref": "#/$defs/sourceEvidence" },
        "expected_sense_count": { "type": "integer", "minimum": 1 },
        "expected_sense_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:w[0-9]{3,}|synthetic-[a-z0-9-]+)-s[0-9]+$" }
        },
        "expected_pos": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["noun", "adjective", "verb", "adverb", "expression"] }
        },
        "expected_glosses": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "required_applicability": { "enum": ["applicable", "not-applicable"] },
        "required_decision": { "enum": ["keep", "split"] },
        "contrast_pairs": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "pattern": "^(?:w[0-9]{3,}|synthetic-[a-z0-9-]+)-s[0-9]+$" }
          }
        },
        "review_requirement": { "type": "string", "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "wave-b-proposal" } } },
          "then": { "required": ["inventory_id"] }
        },
        {
          "if": { "properties": { "scope": { "const": "synthetic-regression" } } },
          "then": {
            "properties": {
              "canonical_id": { "type": "string", "pattern": "^synthetic-[a-z0-9-]+$" }
            },
            "not": { "required": ["inventory_id"] }
          }
        },
        {
          "if": { "properties": { "case_type": { "const": "space-phrase" } } },
          "then": {
            "properties": {
              "required_applicability": { "const": "not-applicable" },
              "required_decision": { "const": "keep" },
              "contrast_pairs": { "type": "array", "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "required_decision": { "const": "split" } } },
          "then": { "properties": { "contrast_pairs": { "type": "array", "minItems": 1 } } }
        },
        {
          "if": { "properties": { "candidate_senses": { "type": "array", "minItems": 2 } } },
          "then": {
            "properties": {
              "required_applicability": { "const": "applicable" },
              "required_decision": { "const": "split" },
              "contrast_pairs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "candidateSense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pos", "gloss"],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:w[0-9]{3,}|synthetic-[a-z0-9-]+)-s[0-9]+$" },
        "pos": { "enum": ["noun", "adjective", "verb", "adverb", "expression"] },
        "gloss": { "type": "string", "pattern": "\\S" }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "candidate_sense_ids", "note"],
      "properties": {
        "kind": { "enum": ["curated-candidate-senses", "canonical-regression", "phrase-boundary"] },
        "candidate_sense_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:w[0-9]{3,}|synthetic-[a-z0-9-]+)-s[0-9]+$" }
        },
        "note": { "type": "string", "pattern": "\\S" }
      }
    }
  }
}
