{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-8-expansion-plan.schema.json",
  "title": "Typewriter M5-8 staged expansion process plan",
  "description": "The process contract for staged M5 expansion. It is planning metadata, not canonical dictionary data or a list of future issues.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "issue",
    "parent_issue",
    "base_inventory_revision",
    "count_unit",
    "canonical_baseline",
    "workflow",
    "gate",
    "ladder"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "plan_id": {
      "type": "string",
      "pattern": "^m5-8-[a-z0-9][a-z0-9-]*$"
    },
    "issue": { "const": 93 },
    "parent_issue": { "const": 7 },
    "base_inventory_revision": { "const": "m5-5" },
    "count_unit": { "const": "canonical-start-net-increase" },
    "canonical_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_count",
        "start_count",
        "reference_only_count",
        "sense_count",
        "relation_count",
        "expression_count"
      ],
      "properties": {
        "record_count": { "type": "integer", "minimum": 0 },
        "start_count": { "type": "integer", "minimum": 0 },
        "reference_only_count": { "type": "integer", "minimum": 0 },
        "sense_count": { "type": "integer", "minimum": 0 },
        "relation_count": { "type": "integer", "minimum": 0 },
        "expression_count": { "type": "integer", "minimum": 0 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_order",
        "partition",
        "stage_report",
        "sense_review",
        "relation_review",
        "candidate_buffer",
        "timing",
        "next_stage_policy"
      ],
      "properties": {
        "phase_order": {
          "const": [
            "target-preparation",
            "sense-review",
            "relation-review",
            "independent-audit",
            "gate-and-promotion"
          ]
        },
        "partition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit", "reviewer_checkpoint", "rework_boundaries"],
          "properties": {
            "unit": { "const": "selected-start" },
            "reviewer_checkpoint": {
              "const": "sense-review-complete-before-relation-review"
            },
            "rework_boundaries": {
              "const": [
                "sense-review",
                "relation-review",
                "independent-audit",
                "post-review-fixes"
              ]
            }
          }
        },
        "stage_report": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_sections", "source_artifacts"],
          "properties": {
            "required_sections": {
              "const": [
                "input",
                "target",
                "decisions",
                "buffer",
                "actual",
                "metrics",
                "source",
                "gate"
              ]
            },
            "source_artifacts": {
              "const": [
                "manifest",
                "metrics",
                "relation_diff",
                "canonical_directory",
                "verification"
              ]
            }
          }
        },
        "sense_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_checks",
            "requires_human_editor",
            "must_complete_before_relation_review"
          ],
          "properties": {
            "required_checks": {
              "const": [
                "lemma-pos",
                "sense-boundaries",
                "literal-figurative",
                "sensory-state-action",
                "expression-boundary"
              ]
            },
            "requires_human_editor": { "const": true },
            "must_complete_before_relation_review": { "const": true }
          }
        },
        "relation_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default_output",
            "zero_relations_allowed",
            "quota",
            "candidate_fields",
            "requires_sense_review",
            "requires_human_editor",
            "admission_failure_categories"
          ],
          "properties": {
            "default_output": { "const": "empty" },
            "zero_relations_allowed": { "const": true },
            "quota": { "const": "none" },
            "candidate_fields": {
              "const": [
                "source_sense",
                "target_sense",
                "direction",
                "type",
                "writer_use_note"
              ]
            },
            "requires_sense_review": { "const": "complete" },
            "requires_human_editor": { "const": true },
            "admission_failure_categories": {
              "const": [
                "broad-common-category",
                "arbitrary-modifier-or-place",
                "incidental-co-occurrence",
                "generic-result-or-reaction",
                "unsupported-cross-sensory",
                "sense-target-type-error"
              ]
            }
          }
        },
        "candidate_buffer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "counts_toward_net_start_increase",
            "selection_formula",
            "import_formula",
            "cumulative_formula",
            "buffer_meaning",
            "buffer_use_formula",
            "buffer_unused_formula",
            "exact_import_required"
          ],
          "properties": {
            "allowed": { "const": true },
            "counts_toward_net_start_increase": { "const": false },
            "selection_formula": {
              "const": "target_net_start_increase + candidate_buffer"
            },
            "import_formula": {
              "const": "imported_start_count = target_net_start_increase"
            },
            "cumulative_formula": {
              "const": "base_start_count + imported_start_count = cumulative_start_target"
            },
            "buffer_meaning": {
              "const": "maximum-reserve-pool"
            },
            "buffer_use_formula": {
              "const": "held_start_count + rejected_start_count <= candidate_buffer"
            },
            "buffer_unused_formula": {
              "const": "deferred_start_count = candidate_buffer - (held_start_count + rejected_start_count)"
            },
            "exact_import_required": { "const": true }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_passes",
            "optional_follow_up_passes",
            "fields",
            "source_command",
            "source_artifacts",
            "actual_event_required",
            "derived_report_required",
            "measured_from_actual_work",
            "unmeasured_follow_up_decision"
          ],
          "properties": {
            "required_passes": {
              "const": [
                "target-preparation",
                "initial-review",
                "feedback-fixes",
                "final-audit",
                "held-rejected"
              ]
            },
            "optional_follow_up_passes": {
              "const": ["post-review-audit", "post-review-fixes"]
            },
            "fields": {
              "const": [
                "started_at",
                "completed_at",
                "wall_clock_seconds",
                "editor_seconds"
              ]
            },
            "source_command": {
              "const": "npm run batch:metrics"
            },
            "source_artifacts": {
              "const": ["manifest", "relation_diff", "canonical_directory"]
            },
            "actual_event_required": { "const": true },
            "derived_report_required": { "const": true },
            "measured_from_actual_work": { "const": true },
            "unmeasured_follow_up_decision": { "const": "incomplete" }
          }
        },
        "next_stage_policy": {
          "const": "create-only-after-previous-gate-pass"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required",
        "correction_rate_max",
        "relation_noise_rate_max",
        "editor_seconds_per_selected_start_max",
        "relation_noise_baseline",
        "relation_noise_below_m5_3_baseline_required",
        "unmeasured_timing_passes_max",
        "open_audit_blockers_max",
        "canonical_integrity_required",
        "deterministic_sqlite_required",
        "search_product_regression_required",
        "exact_net_start_increase_required",
        "failure_decision"
      ],
      "properties": {
        "all_required": { "const": true },
        "correction_rate_max": { "const": 0.5 },
        "relation_noise_rate_max": { "const": 0.25 },
        "editor_seconds_per_selected_start_max": { "const": 12 },
        "relation_noise_baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["noise_event_count", "before_count"],
          "properties": {
            "noise_event_count": { "const": 51 },
            "before_count": { "const": 139 }
          }
        },
        "relation_noise_below_m5_3_baseline_required": { "const": true },
        "unmeasured_timing_passes_max": { "const": 0 },
        "open_audit_blockers_max": { "const": 0 },
        "canonical_integrity_required": { "const": true },
        "deterministic_sqlite_required": { "const": true },
        "search_product_regression_required": { "const": true },
        "exact_net_start_increase_required": { "const": true },
        "failure_decision": { "const": "HOLD PROCESS" }
      }
    },
    "ladder": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "stage_id",
          "target_net_start_increase",
          "cumulative_start_target"
        ],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1, "maximum": 7 },
          "stage_id": {
            "type": "string",
            "pattern": "^m5-8-stage-[0-9]{2}-plus-[0-9]+$"
          },
          "target_net_start_increase": {
            "type": "integer",
            "minimum": 1
          },
          "cumulative_start_target": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
