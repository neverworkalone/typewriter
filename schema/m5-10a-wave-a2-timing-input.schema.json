{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10a-wave-a2-timing-input.schema.json",
  "title": "Typewriter M5-10A Wave A2 editor-session timing input",
  "description": "Recorder output for active editorial work sessions. A complete timing result needs persisted start/stop events and artifact work evidence; command runtime alone is not editor time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timing_id",
    "batch_id",
    "recorder_version",
    "recording_source",
    "recorder_command",
    "processed_start_count",
    "status",
    "passes",
    "events",
    "note"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "timing_id": { "type": "string", "pattern": "^m5-10a-wave-a2-timing-[0-9]{8}$" },
    "batch_id": { "type": "string", "pattern": "^m5-[0-9]+-[a-z0-9][a-z0-9-]*$" },
    "recorder_version": { "const": "timing-recorder-v1" },
    "recording_source": { "const": "timing-recorder-v1" },
    "recorder_command": { "const": "node scripts/batch/record-m5-10a-wave-a2-timing.mjs" },
    "processed_start_count": { "const": 56 },
    "status": { "enum": ["incomplete", "complete"] },
    "passes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/pass" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "recording_proof_sha256": { "$ref": "#/$defs/sha256" },
    "note": { "type": "string", "pattern": "\\S" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "enum": ["target-preparation", "initial-review", "feedback-fixes", "final-audit", "held-rejected"] },
        "status": { "enum": ["unmeasured", "in-progress", "complete"] },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "wall_clock_seconds": { "type": "number", "minimum": 0 },
        "editor_seconds": { "type": "number", "minimum": 0 },
        "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "recording_source": { "const": "timing-recorder-v1" },
        "work_evidence": { "$ref": "#/$defs/workEvidence" }
      }
    },
    "workEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_kind", "unit_count", "unit_ids", "before_sha256", "after_sha256", "note"],
      "properties": {
        "unit_kind": { "enum": ["selected-target", "boundary-check", "sense-correction", "final-audit-item", "buffer-decision"] },
        "unit_count": { "type": "integer", "minimum": 1 },
        "unit_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "\\S" } },
        "before_sha256": { "$ref": "#/$defs/sha256" },
        "after_sha256": { "$ref": "#/$defs/sha256" },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "pass_id", "kind", "session_id", "at"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^m5-10a-wave-a2-timing-event-[0-9]{4}$" },
        "pass_id": { "enum": ["target-preparation", "initial-review", "feedback-fixes", "final-audit", "held-rejected"] },
        "kind": { "enum": ["start", "stop"] },
        "session_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
