{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/relation-diff.schema.json",
  "title": "Typewriter relation diff artifact",
  "description": "Event-level changes between a temporary relation snapshot and its reviewed final snapshot. It never stores a raw model response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "before_count",
    "after_count",
    "events"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "before_count": {
      "type": "integer",
      "minimum": 0
    },
    "after_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_reviews": {
      "description": "Source-bound admission decisions for a pure-add candidate set. Mixed relation changes use a separate diff artifact.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidateReview" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "source_note": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "type"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}$"
        },
        "target_sense": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}-s[1-9][0-9]*$"
        },
        "type": {
          "enum": [
            "direct",
            "near",
            "antonym",
            "mood",
            "scene",
            "sensory",
            "action",
            "association"
          ]
        }
      }
    },
    "candidateReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "relation_id",
        "source_sense",
        "relation",
        "decision",
        "review_note"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "relation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "source_sense": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}-s[1-9][0-9]*$"
        },
        "relation": { "$ref": "#/$defs/relation" },
        "decision": { "enum": ["admit", "reject"] },
        "error_category": {
          "enum": [
            "incidental-co-occurrence",
            "generic-result-or-reaction",
            "arbitrary-modifier-or-place",
            "broad-common-category",
            "unsupported-cross-sensory",
            "sense-target-type-error"
          ]
        },
        "review_note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "reject" } }
          },
          "then": { "required": ["error_category"] }
        },
        {
          "if": {
            "properties": { "decision": { "const": "admit" } }
          },
          "then": { "not": { "required": ["error_category"] } }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "relation_id",
        "operation",
        "source_sense"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "relation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "operation": {
          "enum": ["add", "remove", "retype", "retarget"]
        },
        "source_sense": {
          "type": "string",
          "pattern": "^[wr][0-9]{3,}-s[1-9][0-9]*$"
        },
        "before": { "$ref": "#/$defs/relation" },
        "after": { "$ref": "#/$defs/relation" },
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["target", "target_sense", "type"]
          }
        },
        "error_category": {
          "enum": [
            "incidental-co-occurrence",
            "generic-result-or-reaction",
            "arbitrary-modifier-or-place",
            "broad-common-category",
            "unsupported-cross-sensory",
            "sense-target-type-error"
          ]
        }
      }
    }
  }
}
