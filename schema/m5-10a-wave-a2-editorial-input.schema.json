{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10a-wave-a2-editorial-input.schema.json",
  "title": "Typewriter M5-10A Wave A2 editorial proposal input",
  "description": "A separately recorded editorial proposal. Only a verified human session may mark this input complete; a complete input binds the final reviewed canonical staging digest, and an unverified draft cannot produce a completed review claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_id",
    "batch_id",
    "inventory_id",
    "inventory_revision",
    "source_kind",
    "provenance",
    "created_at",
    "status",
    "sense_review",
    "proposal_staging",
    "records"
  ],
  "properties": {
    "schema_version": { "const": "2" },
    "input_id": { "type": "string", "pattern": "^m5-10a-wave-a2-editorial-input-[0-9]{8}$" },
    "batch_id": { "type": "string", "pattern": "^m5-[0-9]+-[a-z0-9][a-z0-9-]*$" },
    "inventory_id": { "const": "m5-core-5k" },
    "inventory_revision": { "type": "string", "pattern": "^m5-[1-9][0-9]*$" },
    "source_kind": { "enum": ["human-authored", "unverified-draft"] },
    "provenance": { "$ref": "#/$defs/provenance" },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["in-review", "complete"] },
    "sense_review": { "$ref": "#/$defs/senseReview" },
    "proposal_staging": { "$ref": "#/$defs/proposalStaging" },
    "reviewed_staging_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "records": {
      "type": "array",
      "minItems": 58,
      "maxItems": 58,
      "items": { "$ref": "#/$defs/recordReview" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source_kind": { "const": "human-authored" } }
      },
      "then": {
        "properties": { "status": { "const": "complete" } },
        "required": ["reviewed_staging_sha256"]
      }
    },
    {
      "if": {
        "properties": { "source_kind": { "const": "unverified-draft" } }
      },
      "then": {
        "properties": { "status": { "const": "in-review" } },
        "not": { "required": ["reviewed_staging_sha256"] }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "complete" } }
      },
      "then": { "required": ["completed_at"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "in-review" } }
      },
      "then": { "not": { "required": ["completed_at"] } }
    }
  ],
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_status",
        "actor_kind",
        "actor_id",
        "session_id",
        "artifact",
        "sha256",
        "note"
      ],
      "properties": {
        "verification_status": { "enum": ["verified", "unverified"] },
        "actor_kind": { "enum": ["human", "unknown"] },
        "actor_id": { "type": "string", "pattern": "\\S" },
        "session_id": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "artifact": {
          "type": ["string", "null"],
          "pattern": "^data/batches/[a-z0-9][a-z0-9-]*\\.(json|jsonl)$"
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "senseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "boundary_ids",
        "reviewed_start_count",
        "scoped_single_sense_count",
        "split_record_count",
        "split_canonical_ids",
        "note"
      ],
      "properties": {
        "status": { "enum": ["in-review", "complete"] },
        "boundary_ids": {
          "const": [
            "physical-figurative",
            "homonym-pos",
            "sensory-emotion-state-action",
            "directional-symmetry",
            "compound-spaced-phrase",
            "word-idiom"
          ]
        },
        "reviewed_start_count": { "type": "integer", "minimum": 0 },
        "scoped_single_sense_count": { "type": "integer", "minimum": 0 },
        "split_record_count": { "type": "integer", "minimum": 0 },
        "split_canonical_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^w[0-9]{3,}$" }
        },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "proposalStaging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "note"],
      "properties": {
        "format": { "const": "canonical-jsonl" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "note": { "type": "string", "pattern": "\\S" }
      }
    },
    "recordReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "decision", "decision_note"],
      "properties": {
        "inventory_id": { "type": "string", "pattern": "^m5-[0-9]{3}$" },
        "canonical_id": { "type": "string", "pattern": "^w[0-9]{3,}$" },
        "proposal_canonical_id": { "type": "string", "pattern": "^w[0-9]{3,}$" },
        "decision": { "enum": ["included", "corrected", "held", "rejected", "deferred", "proposed"] },
        "proposal_decision": { "enum": ["included", "corrected"] },
        "corrected_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "proposal_corrected_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "decision_note": { "type": "string", "pattern": "\\S" },
        "observed_sense_count": { "type": "integer", "minimum": 0 },
        "observed_pos": {
          "type": "array",
          "items": { "enum": ["noun", "adjective", "verb", "expression"] }
        },
        "boundary_evidence": { "$ref": "#/$defs/boundaryEvidenceSet" },
        "unreviewed_note": { "type": "string", "pattern": "\\S" }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "enum": ["included", "corrected"] } } },
          "then": {
            "required": ["canonical_id", "observed_sense_count", "observed_pos", "boundary_evidence"],
            "not": { "required": ["unreviewed_note"] }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "proposed" } } },
          "then": {
            "required": ["proposal_canonical_id", "proposal_decision", "observed_sense_count", "observed_pos", "boundary_evidence"],
            "not": {
              "anyOf": [
                { "required": ["canonical_id"] },
                { "required": ["corrected_fields"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": { "const": "proposed" },
              "proposal_decision": { "const": "corrected" }
            }
          },
          "then": { "required": ["proposal_corrected_fields"] }
        },
        {
          "if": {
            "properties": {
              "decision": { "const": "proposed" },
              "proposal_decision": { "const": "included" }
            }
          },
          "then": { "not": { "required": ["proposal_corrected_fields"] } }
        },
        {
          "if": { "properties": { "decision": { "enum": ["held", "rejected", "deferred"] } } },
          "then": {
            "required": ["unreviewed_note"],
            "not": { "required": ["canonical_id", "observed_sense_count", "observed_pos", "boundary_evidence"] }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "corrected" } } },
          "then": { "required": ["corrected_fields"] }
        },
        {
          "if": { "properties": { "decision": { "enum": ["included", "held", "rejected", "deferred"] } } },
          "then": { "not": { "required": ["corrected_fields"] } }
        }
      ]
    },
    "boundaryEvidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical-figurative",
        "homonym-pos",
        "sensory-emotion-state-action",
        "directional-symmetry",
        "compound-spaced-phrase",
        "word-idiom"
      ],
      "properties": {
        "physical-figurative": { "$ref": "#/$defs/boundaryEvidence" },
        "homonym-pos": { "$ref": "#/$defs/boundaryEvidence" },
        "sensory-emotion-state-action": { "$ref": "#/$defs/boundaryEvidence" },
        "directional-symmetry": { "$ref": "#/$defs/boundaryEvidence" },
        "compound-spaced-phrase": { "$ref": "#/$defs/boundaryEvidence" },
        "word-idiom": { "$ref": "#/$defs/boundaryEvidence" }
      }
    },
    "boundaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_status", "applicability", "candidate_sense_ids", "decision", "contrasts"],
      "properties": {
        "review_status": { "enum": ["unreviewed", "reviewed"] },
        "applicability": { "enum": ["applicable", "not-applicable", "unknown"] },
        "candidate_sense_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^w[0-9]{3,}-s[0-9]+$" }
        },
        "decision": { "enum": ["pending", "keep", "split"] },
        "contrasts": {
          "type": "array",
          "items": { "$ref": "#/$defs/contrast" }
        }
      }
    },
    "contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_sense_id",
        "right_sense_id",
        "dimension",
        "facets",
        "left_observation",
        "right_observation",
        "difference"
      ],
      "properties": {
        "left_sense_id": { "type": "string", "pattern": "^w[0-9]{3,}-s[0-9]+$" },
        "right_sense_id": { "type": "string", "pattern": "^w[0-9]{3,}-s[0-9]+$" },
        "dimension": { "type": "string", "pattern": "\\S" },
        "facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        },
        "left_observation": { "type": "string", "pattern": "\\S" },
        "right_observation": { "type": "string", "pattern": "\\S" },
        "difference": { "type": "string", "pattern": "\\S" }
      }
    }
  }
}
