{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://typewriter.neverworkalone.dev/schema/m5-10d-authorization.schema.json",
  "title": "Typewriter M5-10D M5-11 authorization",
  "description": "Digest-bound authorization for the separate M5-11 +500 task.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "issue", "parent_issue", "target_issue", "process_revision", "decision", "canonical_mutation", "source", "failed_stage", "target", "created_at", "note"],
  "properties": {
    "schema_version": { "const": "1" },
    "authorization_id": { "const": "m5-10d-m5-11-authorization-20260912" },
    "issue": { "const": 115 },
    "parent_issue": { "const": 7 },
    "target_issue": { "const": 97 },
    "process_revision": { "const": "m5-10d-editor-workload-v1" },
    "decision": { "const": "AUTHORIZE M5-11 +500 VALIDATION" },
    "canonical_mutation": { "const": false },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovery_artifact", "recovery_artifact_sha256", "workload", "workload_sha256", "canonical_directory", "canonical_directory_sha256", "inventory", "inventory_sha256", "repair_revision", "repair_revision_sha256"],
      "properties": {
        "recovery_artifact": { "const": "data/batches/m5-10d-recovery.json" },
        "recovery_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "workload": { "const": "data/batches/m5-10d-workload-20260912.json" },
        "workload_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_directory": { "const": "data/canonical" },
        "canonical_directory_sha256": { "$ref": "#/$defs/sha256" },
        "inventory": { "const": "data/inventory/m5-target-inventory.json" },
        "inventory_sha256": { "$ref": "#/$defs/sha256" },
        "repair_revision": { "const": "data/batches/m5-10a-process-correction.json" },
        "repair_revision_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "failed_stage": { "$ref": "#/$defs/failedStage" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_start_count", "net_start_increase", "cumulative_start_target", "candidate_data_created"],
      "properties": {
        "base_start_count": { "const": 778 },
        "net_start_increase": { "const": 500 },
        "cumulative_start_target": { "const": 1278 },
        "candidate_data_created": { "const": false }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "pattern": "\\S" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "failedStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "gate_status", "decision", "next_stage_authorized", "start_count"],
      "properties": {
        "path": { "const": "data/batches/m5-10-wave-b-stage.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "gate_status": { "const": "fail" },
        "decision": { "const": "HOLD PROCESS" },
        "next_stage_authorized": { "const": false },
        "start_count": { "const": 778 }
      }
    }
  }
}
